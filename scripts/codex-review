#!/usr/bin/env bash
set -euo pipefail

# codex-review — 调用 Codex 对当前工作区变更进行独立审核
#
# 用法: codex-review
#
# Codex 以 writable sandbox 运行（允许执行测试命令），输出通过 -o 写入 /tmp
# 临时文件，由本 wrapper 验证业务代码未被修改后，再写入 .ai/REVIEW.md。
# 沙箱为 ephemeral 模式（退出后丢弃），且脚本强制校验业务文件未被修改。

# === 前置检查 ===

# 1. 确认是 Git 仓库并切换到 repo root
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "[ERROR] 当前目录不是 Git 仓库"
    exit 1
fi
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 2. 确认 AGENTS.md 存在
if [ ! -f AGENTS.md ]; then
    echo "[ERROR] AGENTS.md 不存在"
    exit 1
fi

# 3. 确认 TASK.md 存在
if [ ! -f .ai/TASK.md ]; then
    echo "[ERROR] .ai/TASK.md 不存在"
    exit 1
fi

# 4. 确认 IMPLEMENTATION.md 存在
if [ ! -f .ai/IMPLEMENTATION.md ]; then
    echo "[ERROR] .ai/IMPLEMENTATION.md 不存在，请先运行 cursor-implement"
    exit 1
fi

# === Task-ID 验证 ===
TASK_ID=$(grep -oP 'Task-ID:\s*\K\S+' .ai/TASK.md 2>/dev/null || echo "")
if [ -z "$TASK_ID" ]; then
    echo "[ERROR] .ai/TASK.md 缺少 Task-ID（格式: Task-ID: TASK-YYYYMMDD-HHMMSS）"
    exit 1
fi

IMPL_TASK_ID=$(grep -oP 'Task-ID:\s*\K\S+' .ai/IMPLEMENTATION.md 2>/dev/null || echo "")
if [ "$TASK_ID" != "$IMPL_TASK_ID" ]; then
    echo "[ERROR] Task-ID 不匹配"
    echo "  TASK:           $TASK_ID"
    echo "  IMPLEMENTATION: $IMPL_TASK_ID"
    exit 1
fi

# === 检查/清理旧 REVIEW.md ===
if [ -f .ai/REVIEW.md ]; then
    REVIEW_TASK_ID=$(grep -oP 'Task-ID:\s*\K\S+' .ai/REVIEW.md 2>/dev/null || echo "")
    if [ "$REVIEW_TASK_ID" != "$TASK_ID" ]; then
        echo "[INFO] 发现旧 REVIEW.md (Task-ID: $REVIEW_TASK_ID)，已删除"
        rm -f .ai/REVIEW.md
    fi
fi

# === Review 轮次检查 ===
MAX_REVIEW_ROUNDS=3
REVIEW_ROUND=1
if [ -f .ai/REVIEW_ROUND ]; then
    REVIEW_ROUND=$(cat .ai/REVIEW_ROUND)
    REVIEW_ROUND=$((REVIEW_ROUND + 1))
fi
if [ "$REVIEW_ROUND" -gt "$MAX_REVIEW_ROUNDS" ]; then
    echo "[ERROR] 已达最大 Review 轮次 ($MAX_REVIEW_ROUNDS)，BLOCKED"
    echo "请人工检查 .ai/TASK.md 和 .ai/IMPLEMENTATION.md，决定下一步。"
    exit 4
fi
echo "$REVIEW_ROUND" > .ai/REVIEW_ROUND

# === 审核前状态快照 ===
echo "=== codex-review ==="
echo "Task-ID: $TASK_ID"
echo "Review Round: $REVIEW_ROUND / $MAX_REVIEW_ROUNDS"
echo "cwd:      $(pwd)"
echo "branch:   $(git branch --show-current)"
echo ""
echo "=== git status (review 前) ==="
git status
echo ""

# 保存审核前的完整 porcelain 状态
BEFORE_PORCELAIN=$(git status --porcelain 2>/dev/null)

# === 构建 Codex 审核提示词 ===
REVIEW_PROMPT="你是 Codex，本工作流中的 Independent Reviewer。

你必须独立审核以下变更，不得因为 Cursor 或 Claude 的结论就直接相信。

## 审核步骤

1. 读取项目 AGENTS.md
2. 读取 .ai/TASK.md（Task-ID: ${TASK_ID}）
3. 读取 .ai/IMPLEMENTATION.md
4. 执行 git status
5. 检查 git diff（所有未提交变更）
6. 阅读相关源代码和测试
7. 执行测试命令验证

## 优先检查项

- 功能正确性
- 验收标准是否满足
- 数据破坏风险
- 安全问题
- 并发问题
- 事务问题
- 异常处理
- 回归风险
- 测试覆盖
- 范围越界（是否做了 TASK 范围外的修改）
- 明显过度设计

## 约束

- 你可以运行测试命令（vitest、dotnet test、npm run build）验证代码
- 不得修改任何业务文件（脚本会在审核后强制检查，发现修改则审核无效）
- 不自动修复发现的问题
- 只允许三种结论：PASS / CHANGES_REQUESTED / BLOCKED
- 不允许为了\"显得 Review 有价值\"而强行找问题
- 没有实际问题就必须 PASS

## 输出格式

你的最终回复必须严格按以下格式输出：

# REVIEW

Task-ID: ${TASK_ID}

Verdict: PASS

或

Verdict: CHANGES_REQUESTED

或

Verdict: BLOCKED

每个 finding 必须包含：
- Severity
- 文件
- 位置
- 问题
- 证据
- 触发条件
- 影响
- 最小修复建议

如果没有 findings 且 Verdict 为 PASS，写 \"No issues found.\""

# === 调用 Codex ===
echo "=== 调用 Codex Reviewer (writable sandbox, ephemeral) ==="
echo ""

REVIEW_TMP=$(mktemp /tmp/codex-review-XXXXXX)
set +e
codex exec --sandbox writable --ephemeral -o "$REVIEW_TMP" "$REVIEW_PROMPT"
CODEX_EXIT=$?
set -e

echo ""
echo "=== Codex 退出码: $CODEX_EXIT ==="

# === 审核后检查：业务代码是否被修改 ===
echo ""
echo "=== git status (review 后) ==="
git status
echo ""

AFTER_PORCELAIN=$(git status --porcelain 2>/dev/null)

# 从 before/after 中排除工作流文件（.ai/ 目录下的所有文件）
BEFORE_BUSINESS=$(echo "$BEFORE_PORCELAIN" | grep -v '^.. \.ai/' || true)
AFTER_BUSINESS=$(echo "$AFTER_PORCELAIN" | grep -v '^.. \.ai/' || true)

if [ "$BEFORE_BUSINESS" != "$AFTER_BUSINESS" ]; then
    echo "[ERROR] Review 过程中业务代码发生了变化！"
    echo "Codex Review 不得修改业务文件。此 Review 结果无效。"
    echo ""
    echo "Before:"
    echo "$BEFORE_BUSINESS"
    echo ""
    echo "After:"
    echo "$AFTER_BUSINESS"
    rm -f "$REVIEW_TMP"
    exit 3
fi

# === 检查 Codex 输出 ===
if [ $CODEX_EXIT -ne 0 ]; then
    echo "[ERROR] Codex 执行失败 (exit code: $CODEX_EXIT)"
    rm -f "$REVIEW_TMP"
    exit 2
fi

if [ ! -s "$REVIEW_TMP" ]; then
    echo "[ERROR] Codex 未产生输出"
    rm -f "$REVIEW_TMP"
    exit 2
fi

# === 写入 REVIEW.md ===
cp "$REVIEW_TMP" .ai/REVIEW.md
rm -f "$REVIEW_TMP"

echo "[OK] .ai/REVIEW.md 已生成"
echo ""

# === 验证 REVIEW Task-ID ===
REVIEW_TASK_ID=$(grep -oP 'Task-ID:\s*\K\S+' .ai/REVIEW.md 2>/dev/null || echo "")
if [ "$TASK_ID" != "$REVIEW_TASK_ID" ]; then
    echo "[ERROR] REVIEW Task-ID 不匹配"
    echo "  TASK:   $TASK_ID"
    echo "  REVIEW: $REVIEW_TASK_ID"
    exit 1
fi

# === 解析 Verdict ===
VERDICT=$(grep -oP 'Verdict:\s*\K\S+' .ai/REVIEW.md 2>/dev/null || echo "")

echo "=== REVIEW.md 内容预览 ==="
head -30 .ai/REVIEW.md
echo ""

case "$VERDICT" in
    PASS)
        echo "[OK] Codex Review: PASS"
        rm -f .ai/REVIEW_ROUND
        echo ""
        echo "状态: READY_FOR_USER_COMMIT"
        echo "请在 commit 或 stash 当前变更后再开始下一任务。"
        ;;
    CHANGES_REQUESTED)
        echo "[INFO] Codex Review: CHANGES_REQUESTED (round $REVIEW_ROUND / $MAX_REVIEW_ROUNDS)"
        if [ "$REVIEW_ROUND" -ge "$MAX_REVIEW_ROUNDS" ]; then
            echo "[WARNING] 已达到最大 Review 轮次，下一轮将 BLOCKED。"
        fi
        ;;
    BLOCKED)
        echo "[INFO] Codex Review: BLOCKED"
        rm -f .ai/REVIEW_ROUND
        echo "请人工检查 blocker 并决定下一步。"
        ;;
    *)
        echo "[ERROR] 无法解析 REVIEW.md 中的 Verdict"
        echo "期望: PASS | CHANGES_REQUESTED | BLOCKED"
        echo "实际: $VERDICT"
        exit 1
        ;;
esac

echo ""
echo "[OK] codex-review 完成"
